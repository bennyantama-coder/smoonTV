<?xml version="1.0" encoding="utf-8"?>
<!-- The prayer sky sits behind one scrolling page. Nothing is focusable: MainActivity owns the D-pad
     and draws focus itself (gold ring / gold button), so navigation never depends on focus search. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lapis_900">

    <tv.widgetv.home.SkyView
        android:id="@+id/sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:id="@+id/wallpaper_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#660C1B33"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:descendantFocusability="blocksDescendants"
        android:overScrollMode="never"
        android:scrollbars="none">

        <FrameLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false">

            <LinearLayout
                android:id="@+id/column"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="vertical">

                <!-- First screen; height is set to the window height in code. -->
                <FrameLayout
                    android:id="@+id/first_screen"
                    android:layout_width="match_parent"
                    android:layout_height="540dp"
                    android:clipChildren="false">

                    <!-- Widget rows stack from the top; the dock stays at the bottom. Order and size come from HomePrefs. -->
                    <LinearLayout
                        android:id="@+id/widget_column"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipChildren="false"
                        android:orientation="vertical"
                        android:paddingEnd="56dp"
                        android:paddingStart="52dp"
                        android:paddingTop="16dp">

                        <LinearLayout
                            android:id="@+id/rows"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipChildren="false"
                            android:orientation="vertical">

                            <LinearLayout
                                android:id="@+id/header"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clipChildren="false"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/clock"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:includeFontPadding="false"
                                    android:letterSpacing="-0.02"
                                    android:textColor="@color/plaster_100"
                                    android:textSize="75sp" />

                                <TextView
                                    android:id="@+id/date"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="@font/alexandria"
                                    android:textColor="@color/plaster_100"
                                    android:textSize="14sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/here_weather"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/weather_city"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="12dp"
                                    android:fontFamily="@font/alexandria"
                                    android:textColor="@color/mist_400"
                                    android:textSize="16sp" />

                                <TextView
                                    android:id="@+id/here_temp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:includeFontPadding="false"
                                    android:textColor="@color/plaster_100"
                                    android:textSize="24sp" />
                            </LinearLayout>

                            <tv.widgetv.home.PrayerTimeline
                                android:id="@+id/timeline"
                                android:layout_width="match_parent"
                                android:layout_height="76dp"
                                android:layout_marginTop="14dp" />

                            <LinearLayout
                                android:id="@+id/thought"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="80dp"
                                android:layout_marginStart="80dp"
                                android:layout_marginTop="16dp"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/thought_tag"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/alexandria"
                                    android:letterSpacing="0.22"
                                    android:textAllCaps="true"
                                    android:textColor="@color/gold_400"
                                    android:textSize="10sp" />

                                <TextView
                                    android:id="@+id/thought_text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/cormorant_garamond_italic"
                                    android:gravity="center"
                                    android:maxLines="2"
                                    android:textColor="@color/plaster_100"
                                    android:textSize="19sp" />

                                <TextView
                                    android:id="@+id/thought_source"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:fontFamily="@font/alexandria"
                                    android:textColor="@color/mist_400"
                                    android:textSize="10sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <Space
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/edit_hint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:fontFamily="@font/alexandria"
                            android:gravity="center"
                            android:text="@string/edit_hint"
                            android:textColor="@color/mist_400"
                            android:textSize="12sp" />

                        <FrameLayout
                            android:id="@+id/dock_band"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:layout_marginEnd="64dp"
                            android:layout_marginStart="68dp"
                            android:background="@drawable/bg_band"
                            android:clipChildren="false"
                            android:paddingBottom="2dp"
                            android:paddingEnd="8dp"
                            android:paddingStart="8dp"
                            android:paddingTop="0dp">

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/dock"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clipChildren="false"
                                android:overScrollMode="never" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Top right: icon buttons (SSID label appears left of them while Wi-Fi is focused),
                         and under them the Kitchener time + weather, right-aligned. -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_marginEnd="56dp"
                        android:layout_marginTop="34dp"
                        android:gravity="end"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/ssid"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="4dp"
                                android:fontFamily="@font/alexandria"
                                android:maxWidth="220dp"
                                android:singleLine="true"
                                android:ellipsize="end"
                                android:textColor="@color/mist_400"
                                android:textSize="12sp"
                                android:visibility="gone" />

                            <ImageView
                                android:id="@+id/btn_inputs"
                                style="@style/RoundButton"
                                android:src="@drawable/ic_input" />

                            <ImageView
                                android:id="@+id/btn_wifi"
                                style="@style/RoundButton"
                                android:src="@drawable/ic_wifi" />

                            <ImageView
                                android:id="@+id/btn_settings"
                                style="@style/RoundButton"
                                android:src="@drawable/ic_settings" />
                        </LinearLayout>

                        <!-- Second clock: flag, time, then icon + temp; high/low right-aligned under it. -->
                        <LinearLayout
                            android:id="@+id/away_row"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/away_flag"
                                android:layout_width="11dp"
                                android:layout_height="7.5dp"
                                android:layout_marginEnd="8dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/flag_ca" />

                            <TextView
                                android:id="@+id/away_clock"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:textColor="@color/mist_400"
                                android:textSize="22sp" />

                            <TextView
                                android:id="@+id/away_temp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:includeFontPadding="false"
                                android:textColor="@color/mist_400"
                                android:textSize="22sp"
                                android:visibility="gone" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/away_range"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="@font/alexandria"
                            android:textColor="@color/mist_400"
                            android:textSize="10sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="68dp"
                    android:layout_marginTop="36dp"
                    android:fontFamily="@font/alexandria"
                    android:text="@string/apps"
                    android:textColor="@color/mist_400"
                    android:textSize="16sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="56dp"
                    android:layout_marginStart="56dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingBottom="72dp" />
            </LinearLayout>

            <!-- Inputs dropdown; rows are added in code, position set from the Inputs button. -->
            <LinearLayout
                android:id="@+id/menu"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_menu"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="gone" />

            <!-- Prayer settings; rows are added in code, placed under the timeline. -->
            <LinearLayout
                android:id="@+id/panel"
                android:layout_width="420dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_menu"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="gone" />

            <tv.widgetv.home.GlassHighlight
                android:id="@+id/glass"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </ScrollView>
</FrameLayout>
